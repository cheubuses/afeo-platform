[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "afrosat-eo-platform"
version = "0.1.0"
description = "Sentinel-2 Earth observation processing pipeline for AFROSAT"
requires-python = ">=3.12"

[tool.setuptools]
package-dir = {"" = "src"}

[tool.setuptools.packages.find]
where = ["src"]
