"""Tests for the FastAPI HTTP interface."""

from fastapi.testclient import TestClient

import api.app as app_module


client = TestClient(app_module.app)

VALID_AOI = {
    "type": "Polygon",
    "coordinates": [[
        [36.0, 2.0],
        [36.1, 2.0],
        [36.1, 2.1],
        [36.0, 2.1],
        [36.0, 2.0],
    ]],
}

BASE_REQUEST = {
    "aoi": VALID_AOI,
    "start_date": "2026-03-01",
    "end_date": "2026-03-31",
}


def test_health_endpoint():
    response = client.get("/health")

    assert response.status_code == 200
    assert response.json()["status"] == "ok"


def test_products_endpoint_uses_pipeline_product_list():
    response = client.get("/products")

    assert response.status_code == 200
    assert response.json()["products"] == list(
        app_module.OUTPUT_NAMES
    )


def test_single_product_request_remains_supported(monkeypatch):
    captured = {}

    def fake_pipeline(**kwargs):
        captured.update(kwargs)
        return {
            "status": "completed",
            "process": kwargs["process"],
            "product_path": "/tmp/ndwi.tif",
        }

    monkeypatch.setattr(
        app_module, "run_eo_pipeline", fake_pipeline
    )

    response = client.post(
        "/process",
        json={**BASE_REQUEST, "process": "NDWI"},
    )

    assert response.status_code == 200
    assert response.json()["process"] == "NDWI"
    assert captured["process"] == "NDWI"


def test_multi_product_request_uses_wrapper(monkeypatch):
    captured = {}

    def fake_processing(**kwargs):
        captured.update(kwargs)
        return {
            "status": "completed",
            "requested_products": kwargs["products"],
            "completed_products": len(kwargs["products"]),
            "failed_products": 0,
            "products": {},
            "errors": [],
        }

    monkeypatch.setattr(
        app_module, "run_processing", fake_processing
    )

    requested_products = list(app_module.OUTPUT_NAMES)

    response = client.post(
        "/process",
        json={
            **BASE_REQUEST,
            "products": requested_products,
            "write_valid_count": True,
            "keep_tiles": False,
        },
    )

    assert response.status_code == 200
    assert response.json()["requested_products"] == requested_products
    assert captured["products"] == requested_products
    assert captured["write_valid_count"] is True
    assert captured["keep_tiles"] is False


def test_invalid_date_range_is_rejected():
    response = client.post(
        "/process",
        json={
            **BASE_REQUEST,
            "start_date": "2026-04-01",
            "end_date": "2026-03-01",
        },
    )

    assert response.status_code == 422


def test_unknown_request_field_is_rejected():
    response = client.post(
        "/process",
        json={**BASE_REQUEST, "unexpected_field": True},
    )

    assert response.status_code == 422
